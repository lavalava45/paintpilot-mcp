{
  "name": "photoshop-mcp-digital-painting",
  "version": "1.7.6",
  "description": "Independent Windows-first MCP system for AI-driven digital painting and evidence-bound Photoshop automation.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "photoshop-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "uxp-plugin",
    "examples",
    "scripts/prepare.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "llms.txt",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "npm run build:server",
    "build:server": "node scripts/clean-dist.mjs && tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "verify:photoshop-prompts": "tsx scripts/verify-photoshop-prompt-coverage.ts",
    "generate:tool-backend-inventory": "node scripts/dev/generate-tool-backend-inventory.mjs",
    "verify:painting-policy": "node scripts/verify-digital-painting-policy.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test:mcp-local": "tsx scripts/test-mcp-local.ts",
    "test:measurement-tools": "node scripts/test-measurement-tools.mjs",
    "test:landmark-ergonomics": "node scripts/test-landmark-ergonomics.mjs",
    "test:painting-batching-live": "node scripts/test-painting-batching-live.mjs",
    "test:embedded-guard-mcp": "node scripts/test-embedded-guard-mcp.mjs",
    "test:acceptance": "npm run verify:acceptance-matrix && vitest run --maxWorkers=1 --testTimeout=15000",
    "test:document-targeting": "node scripts/test-document-targeting.mjs",
    "test:document-targeting-live": "node scripts/test-document-targeting-live.mjs",
    "test:color-sampling": "node scripts/test-color-sampling.mjs",
    "test:color-sampling-live": "node scripts/test-color-sampling-live.mjs",
    "prepare": "node scripts/prepare.mjs",
    "sync:server-version": "tsx scripts/sync-server-version.ts",
    "build:mcpb": "tsx scripts/build-mcpb.ts",
    "prepublishOnly": "npm run build && npm run sync:server-version && npm run verify:pack",
    "test:unit": "vitest run",
    "verify:tool-counts": "tsx scripts/verify-tool-counts.ts",
    "verify:acceptance-matrix": "node scripts/verify-acceptance-matrix.mjs",
    "verify:compact-v2-contract": "node scripts/verify-compact-v2-contract-audit.mjs",
    "verify:live-evidence-ledger": "node scripts/verify-live-evidence-ledger.mjs",
    "verify:source-independence": "node scripts/verify-source-independence.mjs",
    "verify:product-identity": "node scripts/verify-product-identity.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "verify:external-intake": "node scripts/verify-external-intake.mjs",
    "verify:canonical": "npm run build:server && npm run verify:pack && npm run lint && npm run test:acceptance && npm run verify:compact-v2-contract && npm run verify:painting-policy && npm run verify:photoshop-prompts && npm run verify:source-independence && npm run verify:product-identity && npm run verify:provenance && npm run verify:external-intake && npm run verify:tool-counts && npm run verify:live-evidence-ledger"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "photoshop",
    "adobe",
    "automation",
    "ai",
    "ai-agents",
    "cursor",
    "claude",
    "image-editing",
    "typescript",
    "windows",
    "developer-tools"
  ],
  "author": "lavalava45",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavalava45/photoshop-mcp-digital-painting.git"
  },
  "homepage": "https://github.com/lavalava45/photoshop-mcp-digital-painting",
  "bugs": {
    "url": "https://github.com/lavalava45/photoshop-mcp-digital-painting/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "private": true,
  "contributors": [
    "lavalava45 (maintainer)"
  ]
}
