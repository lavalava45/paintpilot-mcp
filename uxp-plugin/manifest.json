{
    "id":  "com.photoshop-mcp.uxp-bridge",
    "name":  "Photoshop MCP UXP Bridge",
    "version":  "1.0.0",
    "manifestVersion":  5,
    "main":  "index.html",
    "host":  {
                 "app":  "PS",
                 "minVersion":  "24.0.0"
             },
    "requiredPermissions":  {
                                "network":  {
                                                "domains":  "all"
                                            },
                                "localFileSystem":  "fullAccess"
                            },
    "entrypoints":  [
                        {
                            "type":  "panel",
                            "id":  "bridgePanel",
                            "label":  {
                                          "default":  "MCP Bridge"
                                      },
                            "minimumSize":  {
                                                "width":  240,
                                                "height":  220
                                            },
                            "maximumSize":  {
                                                "width":  700,
                                                "height":  900
                                            },
                            "preferredDockedSize":  {
                                                        "width":  300,
                                                        "height":  420
                                                    },
                            "preferredFloatingSize":  {
                                                          "width":  340,
                                                          "height":  430
                                                      }
                        }
                    ]
}
