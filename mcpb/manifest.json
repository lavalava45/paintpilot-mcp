{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "photoshop-mcp-digital-painting",
  "display_name": "PaintPilot — Photoshop Tools",
  "version": "1.8.0-preview.1",
  "description": "PaintPilot Photoshop Tools: direct Photoshop commands through MCP and UXP on Windows.",
  "long_description": "PaintPilot Photoshop Tools is the direct-command mode of the independently maintained PaintPilot Photoshop automation product. It uses MCP and the Photoshop UXP companion without the artistic painting Guard workflow. For both Painting Mode and Photoshop Tools, install the PaintPilot Windows ZIP instead. PaintPilot is not affiliated with or endorsed by Adobe Inc. Provenance and licensing are documented in NOTICE and LICENSE.",
  "author": {
    "name": "lavalava45",
    "url": "https://github.com/lavalava45/paintpilot-mcp"
  },
  "homepage": "https://github.com/lavalava45/paintpilot-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/lavalava45/paintpilot-mcp"
  },
  "documentation": "https://github.com/lavalava45/paintpilot-mcp/blob/digital-painting/INSTALL.md",
  "support": "https://github.com/lavalava45/paintpilot-mcp/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "photoshop",
    "adobe",
    "image-editing",
    "automation"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/dist/photoshop-tools.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/dist/photoshop-tools.js"
      ],
      "env": {
        "PHOTOSHOP_GUARD_MODE": "off",
        "LOG_LEVEL": "${user_config.logLevel}",
        "PHOTOSHOP_PATH": "${user_config.photoshopPath}"
      }
    }
  },
  "user_config": {
    "logLevel": {
      "type": "string",
      "title": "Log level",
      "description": "0=DEBUG, 1=INFO, 2=WARN, 3=ERROR",
      "default": "1",
      "enum": [
        "0",
        "1",
        "2",
        "3"
      ]
    },
    "photoshopPath": {
      "type": "string",
      "title": "Photoshop install path",
      "description": "Optional. Leave empty to auto-detect the local Photoshop install.",
      "required": false
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": ["win32"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true
}
