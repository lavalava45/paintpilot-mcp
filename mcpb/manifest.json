{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "photoshop-mcp-digital-painting",
  "display_name": "Photoshop MCP — Digital Painting Edition",
  "version": "0.0.0",
  "description": "Independent Photoshop MCP system for digital painting, visual verification, and guarded automation.",
  "long_description": "Photoshop MCP — Digital Painting Edition is an independently maintained Windows-first MCP system for AI-driven digital painting and evidence-bound Photoshop automation. It includes a durable embedded Guard, semantic painting/editing tools, visual verification, and a Photoshop UXP companion. It is not affiliated with or endorsed by Adobe Inc. Historical upstream provenance and licensing are documented in NOTICE and LICENSE.",
  "author": {
    "name": "lavalava45",
    "url": "https://github.com/lavalava45/photoshop-mcp-digital-painting"
  },
  "homepage": "https://github.com/lavalava45/photoshop-mcp-digital-painting",
  "repository": {
    "type": "git",
    "url": "https://github.com/lavalava45/photoshop-mcp-digital-painting"
  },
  "documentation": "https://github.com/lavalava45/photoshop-mcp-digital-painting/blob/digital-painting/INSTALL.md",
  "support": "https://github.com/lavalava45/photoshop-mcp-digital-painting/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "photoshop",
    "adobe",
    "image-editing",
    "automation"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/dist/index.js"
      ],
      "env": {
        "LOG_LEVEL": "${user_config.logLevel}",
        "PHOTOSHOP_PATH": "${user_config.photoshopPath}"
      }
    }
  },
  "user_config": {
    "logLevel": {
      "type": "string",
      "title": "Log level",
      "description": "0=DEBUG, 1=INFO, 2=WARN, 3=ERROR",
      "default": "1",
      "enum": [
        "0",
        "1",
        "2",
        "3"
      ]
    },
    "photoshopPath": {
      "type": "string",
      "title": "Photoshop install path",
      "description": "Optional. Leave empty to auto-detect the local Photoshop install.",
      "required": false
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": ["win32"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true
}
